[Unit]
Description=REMURA Private - Oracle Always Free
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=remura
Group=remura
WorkingDirectory=/opt/remura
EnvironmentFile=/opt/remura/private/remura.env
ExecStart=/opt/remura/.venv/bin/python /opt/remura/scripts/private_server.py --database /opt/remura/private/remura-prices.sqlite3
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/remura/private
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
