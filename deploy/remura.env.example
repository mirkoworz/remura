# REMURA private VPS — template only. Never put secrets in this tracked file.
# Real environment at /opt/remura/private/remura.env (chmod 0600; owner remura).
REMURA_COLLECTOR_ENABLED=0
REMURA_RETAIL_ENABLED=0
REMURA_SYMBOLS=EURUSD,XAUUSD,US500
CTRADER_ENV=demo
# Add these ONLY to the private server file after accounts-only OAuth:
# CTRADER_CLIENT_ID=...
# CTRADER_CLIENT_SECRET=...
# CTRADER_REFRESH_TOKEN=...
# CTRADER_ACCOUNT_ID=...
# Optional Myfxbook:
# MYFXBOOK_EMAIL=...
# MYFXBOOK_PASSWORD=...
