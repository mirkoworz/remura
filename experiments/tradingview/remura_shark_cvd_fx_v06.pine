//@version=6
// REMURA Track D D0.6 | 2026-11-10 Europe/Rome | Bar delta numeric parity
// Data Window exposes independent 5m Delta; no signals from partial history.
// FXCM EURUSD tick-volume proxy: NEVER real exchange aggressor volume.
// TV lists the FX:EURUSD symbol as FXCM. All data must use FX:EURUSD.
indicator("REMURA Shark CVD D0.6 | FX:EURUSD | RESEARCH", shorttitle="REMURA CVD D0.6", overlay=false)

const string FEED = "FX:EURUSD"
const string MODEL = "remura_fx_1m_cvd_d0.6"
int leftBars = input.int(2, "Pivot a sinistra", minval=1, maxval=10)
int rightBars = input.int(2, "Pivot a destra (conferma)", minval=1, maxval=10)
int minDistance = input.int(3, "Separazione minima pivot (barre)", minval=1, maxval=100)
int maxDistance = input.int(72, "Separazione massima pivot (barre)", minval=3, maxval=250)
int minPriceTicks = input.int(5, "Nuovo estremo minimo (tick)", minval=1, maxval=1000)
float minCvdDiff = input.float(10.0, "Differenza CVD minima (volume FXCM)", minval=0, step=1)
bool researchAlerts = input.bool(false, "Alert SOLO RICERCA (disattivato)")

string chartId = ticker.standard(syminfo.main_tickerid)
bool chartOk = chartId == "FX:EURUSD" and timeframe.isminutes and timeframe.multiplier == 5

// Explicit ticker matches Pine diagnostics and TradingView FXCM page.
// All highs/lows and 1m volumes use the SAME canonical FX:EURUSD identifier.
[fxH, fxL, fxT, fxD, fxC, fxTick] = request.security(FEED, "5", [high, low, time, time("D"), close, syminfo.mintick], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[t1, o1, c1, v1] = request.security_lower_tf(FEED, "1", [time, open, close, volume], ignore_invalid_symbol=true)
bool newDay = not na(fxD) and (na(fxD[1]) or fxD != fxD[1])
var float total = 0.0
var float lastMinuteClose = na
var int lastSign = 0
var bool validSession = false
var int countBars = 0
var float segmentCvd = 0.0
var int segmentBars = 0
var int badBarsToday = 0
var int lastIntrabarCount = 0
var string lastQualityReason = "NESSUNA CANDELA CONFERMATA"
var int lastCompleteBarTime = na
float cvd = na
float barDelta = na
float partialPlot = na
float deltaVerified5m = na
float coverage5m = na
var float lastVerifiedDelta = na
var int lastVerifiedDeltaEndMs = na

if chartOk and barstate.isconfirmed
    if newDay
        total := 0.0
        lastMinuteClose := na
        lastSign := 0
        // Strict daily CVD requires proof that the first available 5m
        // candle starts exactly at the feed's daily anchor. If the dataset
        // starts in the middle of a day, do NOT claim complete daily CVD.
        validSession := not na(fxT) and fxT == fxD
        countBars := 0
        segmentCvd := 0.0
        segmentBars := 0
        badBarsToday := 0

    int n = array.size(t1)
    lastIntrabarCount := n
    string reason = "OK"
    bool barValid = true
    if na(fxT)
        barValid := false
        reason := "FX_5M_ASSENTE"
    else if fxT != time
        barValid := false
        reason := "5M_NON_ALLINEATO"
    else if n != 5
        barValid := false
        reason := "1M_PRESENTI_" + str.tostring(n) + "_SU_5"
    else if array.size(o1) != n or array.size(c1) != n or array.size(v1) != n
        barValid := false
        reason := "ARRAY_1M_INCOERENTI"
    else if not newDay and not na(fxT[1]) and fxT - fxT[1] != 300000
        barValid := false
        reason := "GAP_ORARIO_5M"

    // On a new contiguous segment never use a direction inherited from
    // an earlier (possibly incomplete) segment.
    if segmentBars == 0
        lastMinuteClose := na
        lastSign := 0

    float delta = 0.0
    if barValid
        for i = 0 to n - 1
            int tm = array.get(t1, i)
            float o = array.get(o1, i)
            float c = array.get(c1, i)
            float v = array.get(v1, i)
            if tm != fxT + i * 60000
                barValid := false
                reason := "ORARI_1M_NON_CONTIGUI"
                break
            if na(o) or na(c) or na(v) or v < 0
                barValid := false
                reason := "VOLUME_O_PREZZO_1M_ND"
                break
            int sign = c > o ? 1 : c < o ? -1 : na(lastMinuteClose) ? lastSign : c > lastMinuteClose ? 1 : c < lastMinuteClose ? -1 : lastSign
            delta += sign * v
            lastMinuteClose := c
            lastSign := sign

    lastQualityReason := reason
    coverage5m := barValid ? 1.0 : 0.0
    if not barValid
        validSession := false
        badBarsToday += 1
        segmentBars := 0
        segmentCvd := 0.0
        lastMinuteClose := na
        lastSign := 0
    else
        // Per-bar delta is independent of session reset; expose it for
        // comparison ONLY when all five 1m bars have validated. No alerts.
        deltaVerified5m := delta
        lastVerifiedDelta := delta
        lastVerifiedDeltaEndMs := fxT + 300000
        segmentCvd += delta
        segmentBars += 1
        // A separate, explicitly partial plot; cannot enter decisions.
        partialPlot := segmentBars >= 2 ? segmentCvd : na
        lastCompleteBarTime := fxT + 300000
        if validSession
            total += delta
            countBars += 1
            cvd := total
            barDelta := delta

float lowPivot = ta.pivotlow(fxL, leftBars, rightBars)
float highPivot = ta.pivothigh(fxH, leftBars, rightBars)
var float prevLo = na
var float prevLoCvd = na
var int prevLoIndex = na
var int prevLoDay = na
var int prevLoTime = na
var float prevHi = na
var float prevHiCvd = na
var int prevHiIndex = na
var int prevHiDay = na
var int prevHiTime = na
bool bullish = false
bool bearish = false
float oldPrice = na
float newPrice = na
float oldCvd = na
float newCvd = na
int oldTime = na
int newTime = na

// Confirmation is at the right-side bar, never on the historical pivot bar.
if chartOk and barstate.isconfirmed and validSession and not na(cvd) and countBars >= leftBars + rightBars + 2
    int pivotDay = fxD[rightBars]
    int pivotIdx = bar_index - rightBars
    int pivotMs = fxT[rightBars]
    float pivotCvd = cvd[rightBars]
    if pivotDay == fxD and not na(pivotCvd)
        if not na(lowPivot)
            float p = fxL[rightBars]
            int separation = na(prevLoIndex) ? 0 : pivotIdx - prevLoIndex
            bullish := not na(prevLo) and prevLoDay == fxD and separation >= minDistance and separation <= maxDistance and p < prevLo - minPriceTicks * fxTick and pivotCvd > prevLoCvd + minCvdDiff
            if bullish
                oldPrice := prevLo
                newPrice := p
                oldCvd := prevLoCvd
                newCvd := pivotCvd
                oldTime := prevLoTime
                newTime := pivotMs
            prevLo := p
            prevLoCvd := pivotCvd
            prevLoIndex := pivotIdx
            prevLoDay := fxD
            prevLoTime := pivotMs
        if not na(highPivot)
            float p = fxH[rightBars]
            int separation = na(prevHiIndex) ? 0 : pivotIdx - prevHiIndex
            bearish := not na(prevHi) and prevHiDay == fxD and separation >= minDistance and separation <= maxDistance and p > prevHi + minPriceTicks * fxTick and pivotCvd < prevHiCvd - minCvdDiff
            if bearish
                oldPrice := prevHi
                newPrice := p
                oldCvd := prevHiCvd
                newCvd := pivotCvd
                oldTime := prevHiTime
                newTime := pivotMs
            prevHi := p
            prevHiCvd := pivotCvd
            prevHiIndex := pivotIdx
            prevHiDay := fxD
            prevHiTime := pivotMs

// Two DISTINCT series. Orange is an observable partial segment, NOT a
// daily CVD and NEVER eligible for divergence or trade alerts.
plot(chartOk ? cvd : na, "CVD GIORNALIERO (solo dati completi)", color=color.teal, linewidth=2, style=plot.style_linebr)
plot(chartOk and not validSession ? partialPlot : na, "CVD PARZIALE (NO SIGNAL)", color=color.orange, linewidth=2, style=plot.style_linebr)
// Exact bar-delta outputs are in the Data Window and status line, never
// on the pane scale. Missing/incomplete candle intentionally outputs na.
plot(chartOk ? deltaVerified5m : na, "DELTA 5M REMURA verificato", display=display.data_window + display.status_line, precision=2)
plot(chartOk ? coverage5m : na, "QUALITA 5M (1 valida / 0 incompleta)", display=display.data_window, precision=0)
plot(chartOk ? float(lastIntrabarCount) : na, "NUMERO INTRABAR 1M", display=display.data_window, precision=0)
hline(0, "Zero", color=color.gray, linestyle=hline.style_dotted)
plotshape(bullish ? cvd : na, title="Divergenza rialzista (solo sessione valida)", style=shape.triangleup, location=location.absolute, color=color.lime, size=size.small, text="DIV+")
plotshape(bearish ? cvd : na, title="Divergenza ribassista (solo sessione valida)", style=shape.triangledown, location=location.absolute, color=color.red, size=size.small, text="DIV-")
bgcolor(not chartOk or (barstate.isconfirmed and not validSession) ? color.new(color.orange, 92) : na, title="Storico parziale/condizioni non valide")

var table diag = table.new(position.top_right, 1, 8, border_width=1)
if barstate.islast
    string state = not chartOk ? "D0.6 | GRAFICO ERRATO" : validSession ? "D0.6 | CVD GIORNALIERO VALIDO" : segmentBars >= 2 ? "D0.6 | SOLO CVD PARZIALE" : "D0.6 | NESSUN SEGMENTO COMPLETO"
    color stateColor = chartOk and validSession ? color.lime : color.orange
    table.cell(diag, 0, 0, state, text_color=stateColor, bgcolor=color.new(color.black, 15))
    table.cell(diag, 0, 1, "Grafico: " + chartId + " | TF=" + timeframe.period, text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(diag, 0, 2, "Feed usato: FX:EURUSD (TradingView FXCM)", text_color=color.aqua, bgcolor=color.new(color.black, 15))
    table.cell(diag, 0, 3, "Barre 1m ultima 5m chiusa: " + str.tostring(lastIntrabarCount) + "/5", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(diag, 0, 4, "Ultimo controllo: " + lastQualityReason, text_color=lastQualityReason == "OK" ? color.lime : color.orange, bgcolor=color.new(color.black, 15))
    table.cell(diag, 0, 5, "Barre parziali consecutive: " + str.tostring(segmentBars) + " | incomplete oggi: " + str.tostring(badBarsToday), text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(diag, 0, 6, "Ultimo DELTA 5M verificato: " + (na(lastVerifiedDelta) ? "N/D" : str.tostring(lastVerifiedDelta, "#.##")), text_color=color.yellow, bgcolor=color.new(color.black, 15))
    table.cell(diag, 0, 7, "Candela chiusa: " + (na(lastVerifiedDeltaEndMs) ? "N/D" : str.format_time(lastVerifiedDeltaEndMs, "dd/MM HH:mm", "Europe/Rome")) + " Italia", text_color=color.white, bgcolor=color.new(color.black, 15))

// Alert off by default. Manual setup required. No orders or webhook URLs.
if chartOk and researchAlerts and barstate.isrealtime and barstate.isconfirmed and (bullish or bearish)
    string kind = bullish ? "BULLISH_REGULAR" : "BEARISH_REGULAR"
    string eventId = MODEL + "|" + FEED + "|" + kind + "|" + str.tostring(newTime)
    string msg = '{"schema":"remura-research-d0.6","mode":"RESEARCH_ONLY","algorithm":"' + MODEL + '","source":"TV_FX_EURUSD_TICK_VOLUME_PROXY_1M","event_id":"' + eventId + '","symbol":"' + FEED + '","chart_symbol":"' + chartId + '","timeframe":"5","type":"' + kind + '","detected_bar_close_ms":' + str.tostring(fxT + 300000) + ',"pivot1_ms":' + str.tostring(oldTime) + ',"pivot2_ms":' + str.tostring(newTime) + ',"pivot1_price":' + str.tostring(oldPrice, format.mintick) + ',"pivot2_price":' + str.tostring(newPrice, format.mintick) + ',"pivot1_cvd":' + str.tostring(oldCvd) + ',"pivot2_cvd":' + str.tostring(newCvd) + ',"current_price":' + str.tostring(fxC, format.mintick) + ',"current_cvd":' + str.tostring(cvd) + ',"delta_5m":' + str.tostring(barDelta) + '}'
    alert(msg, alert.freq_all)
