//@version=6
// REMURA Delta Peaks LAB v0.3
// Aggiornamento: 11/11/2026 09:03 CET
// Ricerca sperimentale: delta STIMATO, non ordini istituzionali osservati.
// Nessun collegamento con la versione live di REMURA.
import TradingView/ta/14 as tv

indicator("REMURA Delta Peaks LAB v0.3 - 11/11/2026", overlay=true, max_lines_count=10)

// PARAMETRI
lowerTF = input.timeframe("1", "Timeframe delta intrabar")
lookback = input.int(30, "Barre di riferimento", minval=5)
multiplier = input.float(3.5, "Forza minima picco", minval=1, step=0.25)
maxEfficiency = input.float(0.07, "Efficienza ER massima", minval=-1.0, maxval=1.0, step=0.01)
showLevels = input.bool(true, "Mostra livelli WEEK / MONTH")
minPeakGap = input.int(6, "Minimo barre tra picchi (5m = 30 min)", minval=0, maxval=100)
showPeaks = input.bool(false, "Mostra anche D+/D- (diagnostica)")
showER = input.bool(true, "Mostra ER (sforzo / risultato)")

// DELTA STIMATO DA TIMEFRAME INFERIORE
// Il periodo di accumulo coincide con la candela del grafico:
// deltaBar rappresenta quindi il delta stimato di una barra.
[deltaOpen, deltaHigh, deltaLow, deltaBar] = tv.requestVolumeDelta(lowerTF, timeframe.period)

absDelta = math.abs(deltaBar)
// Solo barre precedenti: evitiamo che il picco alteri la propria soglia.
avgDelta = ta.sma(absDelta[1], lookback)
atrValue = ta.atr(14)

// PICCHI: solo a candela confermata; filtro distanza, non un nuovo metodo di delta.
peakCandidate = barstate.isconfirmed and not na(deltaBar) and not na(avgDelta) and avgDelta > 0 and absDelta >= avgDelta * multiplier
var int lastPeakBar = na
isPeak = peakCandidate and (na(lastPeakBar) or bar_index - lastPeakBar > minPeakGap)
if isPeak
    lastPeakBar := bar_index

// SFORZO / RISULTATO: METRICA SPERIMENTALE, NON PROVA DI ASSORBIMENTO
// Sforzo = |delta barra| / media(|delta| delle 30 barre precedenti).
// Risultato direzionale = sign(delta) * (close - open) / ATR(14).
// Efficienza ER = risultato direzionale / sforzo.
// Negativa: corpo nella direzione opposta al delta. Circa zero: poco corpo.
effort = not na(avgDelta) and avgDelta > 0 ? absDelta / avgDelta : na
signedResult = not na(atrValue) and atrValue > 0 and not na(deltaBar) ? math.sign(deltaBar) * (close - open) / atrValue : na
efficiency = not na(effort) and effort > 0 and not na(signedResult) ? signedResult / effort : na
erCandidate = isPeak and not na(efficiency) and efficiency <= maxEfficiency
erPositiveDelta = erCandidate and deltaBar > 0
erNegativeDelta = erCandidate and deltaBar < 0

// MARCATORI - ER+ = pressione positiva inefficiente, ER- = pressione negativa inefficiente
plotshape(showPeaks and isPeak and deltaBar > 0 and not erPositiveDelta, title="Picco positivo", style=shape.circle, location=location.abovebar, color=color.lime, size=size.tiny, text="D+")
plotshape(showPeaks and isPeak and deltaBar < 0 and not erNegativeDelta, title="Picco negativo", style=shape.circle, location=location.belowbar, color=color.red, size=size.tiny, text="D-")
plotshape(showER and erPositiveDelta, title="ER delta positivo", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, text="ER+")
plotshape(showER and erNegativeDelta, title="ER delta negativo", style=shape.triangleup, location=location.belowbar, color=color.aqua, size=size.small, text="ER-")

// MASSIMI ASSOLUTI DEL DELTA NEI PERIODI DISPONIBILI
var float weekMax = na
var float monthMax = na
var float weekPrice = na
var float monthPrice = na
var float previousMonthPrice = na

var line weekLine = na
var line monthLine = na
var line previousLine = na

// NUOVA SETTIMANA
if timeframe.change("1W")
    weekMax := na
    weekPrice := na
    if not na(weekLine)
        line.delete(weekLine)
        weekLine := na

// NUOVO MESE
if timeframe.change("1M")
    previousMonthPrice := monthPrice
    if not na(previousLine)
        line.delete(previousLine)
    previousLine := monthLine
    if not na(previousLine)
        line.set_color(previousLine, color.gray)
        line.set_style(previousLine, line.style_dashed)
    monthLine := na
    monthMax := na
    monthPrice := na

// AGGIORNA I LIVELLI SOLO A CANDELA CHIUSA
// Il prezzo tracciato e' hl2 della candela del massimo delta,
// NON un volume profile POC o il prezzo esatto dello scambio.
if barstate.isconfirmed and not na(deltaBar)
    if na(weekMax) or absDelta > weekMax
        weekMax := absDelta
        weekPrice := hl2
        if not na(weekLine)
            line.delete(weekLine)
        if showLevels
            weekLine := line.new(bar_index, weekPrice, bar_index + 1, weekPrice, extend=extend.right, color=color.aqua, width=2)

    if na(monthMax) or absDelta > monthMax
        monthMax := absDelta
        monthPrice := hl2
        if not na(monthLine)
            line.delete(monthLine)
        if showLevels
            monthLine := line.new(bar_index, monthPrice, bar_index + 1, monthPrice, extend=extend.right, color=color.yellow, width=2)

// DASHBOARD: valori dell'ultima barra, non la statistica delle barre precedenti
var table panel = table.new(position.top_right, 2, 8, border_width=1)
if barstate.islast
    table.cell(panel, 0, 0, "REMURA DELTA", bgcolor=color.black, text_color=color.white)
    table.cell(panel, 1, 0, "LAB v0.3", bgcolor=color.black, text_color=color.white)
    table.cell(panel, 0, 1, "Delta barra")
    table.cell(panel, 1, 1, na(deltaBar) ? "N/D" : str.tostring(deltaBar, format.volume))
    table.cell(panel, 0, 2, "Sforzo (x)")
    table.cell(panel, 1, 2, na(effort) ? "N/D" : str.tostring(effort, "#.##"))
    table.cell(panel, 0, 3, "Risultato (ATR)")
    table.cell(panel, 1, 3, na(signedResult) ? "N/D" : str.tostring(signedResult, "#.###"))
    table.cell(panel, 0, 4, "Efficienza ER")
    table.cell(panel, 1, 4, na(efficiency) ? "N/D" : str.tostring(efficiency, "#.###"))
    table.cell(panel, 0, 5, "WEEK")
    table.cell(panel, 1, 5, na(weekPrice) ? "N/D" : str.tostring(weekPrice, format.mintick), text_color=color.aqua)
    table.cell(panel, 0, 6, "CURRENT MONTH")
    table.cell(panel, 1, 6, na(monthPrice) ? "N/D" : str.tostring(monthPrice, format.mintick), text_color=color.yellow)
    table.cell(panel, 0, 7, "PREVIOUS MONTH")
    table.cell(panel, 1, 7, na(previousMonthPrice) ? "N/D" : str.tostring(previousMonthPrice, format.mintick), text_color=color.gray)

// DATI E ALLARMI - NESSUN WEBHOOK ATTIVATO
plot(deltaBar, "Delta stimato", display=display.data_window)
plot(effort, "Sforzo relativo (x)", display=display.data_window)
plot(signedResult, "Risultato orientato al delta (ATR)", display=display.data_window)
plot(efficiency, "Efficienza ER", display=display.data_window)
alertcondition(isPeak, "REMURA - Picco delta", "Rilevato picco delta su {{ticker}}")
alertcondition(erPositiveDelta, "REMURA - ER delta positivo", "Delta positivo con bassa efficienza su {{ticker}}")
alertcondition(erNegativeDelta, "REMURA - ER delta negativo", "Delta negativo con bassa efficienza su {{ticker}}")
